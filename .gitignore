# ============================================================
# 密钥与凭证 —— 绝不入库
# ============================================================
# IMAP 密码（明文）；多账号时是 secret-<账号名>，所以用通配
config/himalaya/secret*
!config/himalaya/secret.example
# 真实邮箱账号与服务器（含个人/工作邮箱地址，用 config.example.toml 代替）
config/himalaya/config.toml
# 应用级共同配置（含 AI API Key，明文）
config/app.toml
# 原始备份包里同样含明文密码
himalaya-backup-*.tar.gz
*.tar.gz
.env
*.key
*.pem

# ============================================================
# 本地数据与缓存（运行期生成）
# ============================================================
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# ============================================================
# 可选：外部项目的本地源码树（开发者本地 clone 用，非必须）
# 依赖应以 pip 包形式安装，见 requirements.txt
# ============================================================
source/

# ============================================================
# 编辑器与系统
# ============================================================
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ============================================================
# 本地开发上下文（AI 助手的项目记忆与工作日志，含私人信息）
# ============================================================
.workbuddy/

# 本机 Python 解释器路径（含本机用户名，用 python.local.example.txt 代替）
scripts/python.local.txt

# MCP 接入文档的本机实填版（含 tailnet 主机名等，用 docs/mcp-setup.example.md 代替）
docs/mcp-setup.md
